# Runtime server-to-server endpoint for all CMS reads.
# During the Tailscale recipe, the CMS tunnel listens on localhost:1340.
STRAPI_URL=http://localhost:1337
# Browser-facing CMS origin and public site origin; never baked into the image.
PUBLIC_STRAPI_URL=http://localhost:1337
SITE_URL=http://localhost:3000
# Legacy aliases retained for existing local recipe scripts.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# Optional comma-separated HTTPS origins when GPX media is served outside Strapi.
STRAPI_MEDIA_ORIGINS=https://cellar-c2.services.clever-cloud.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional, comma-separated hostnames used to access the Next.js dev server remotely.
NEXT_ALLOWED_DEV_ORIGINS=
# Optional server-side switch for the deferred OpenFreeMap basemap. Fails closed.
ITINERARY_BASEMAP_ENABLED=false
STRAPI_API_TOKEN=
PREVIEW_SECRET=replace-with-the-same-long-random-secret-as-the-cms
